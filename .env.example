# Application
ENVIRONMENT=paper

# Database
POSTGRES_PASSWORD=hf_secret_2024

# AI Provider — set one or both. System auto-selects Groq if Anthropic key missing.
# AI_PROVIDER=auto   # options: auto | anthropic | groq
ANTHROPIC_API_KEY=your_anthropic_key_here

# Groq (free tier — fast inference with Llama 3.3 70B)
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Alpaca (free paper trading)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Bybit
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# On-chain data (optional)
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=

# Monitoring
GRAFANA_PASSWORD=admin

# Risk limits (USD)
MAX_DAILY_LOSS=500
MAX_WEEKLY_LOSS=1500
MAX_MONTHLY_DRAWDOWN=5000
MAX_POSITION_SIZE_USD=100
MAX_LEVERAGE=1.0
